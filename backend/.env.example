PORT=5000

# Origin frontend yang diizinkan (pisahkan dengan koma untuk beberapa origin)
CORS_ORIGIN=http://localhost:5173

# Database Turso (libSQL)
# Remote:  TURSO_DATABASE_URL=libsql://<nama-db>-<organisasi>.turso.io
#          TURSO_AUTH_TOKEN=<token dari dashboard Turso>
# Local:   biarkan kosong keduanya, otomatis memakai file data/karang-taruna.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secret untuk JWT (login admin) — ganti dengan nilai acak yang aman
JWT_SECRET=ganti-dengan-secret-acak-yang-aman
