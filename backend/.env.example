PORT=5000

# ⚠️ PENTING: gunakan nilai RAHASIA yang BERBEDA antara development dan production.
# Jangan menyalin nilai .env production ke .env lokal (atau sebaliknya). File .env
# lokal tidak ikut ter-deploy dan bisa saja bocor dari mesin development.
# Untuk development, biarkan TURSO_* kosong agar memakai SQLite lokal.

# Origin frontend yang diizinkan (pisahkan dengan koma untuk beberapa origin)
CORS_ORIGIN=http://localhost:5173

# Aktifkan (isi 1, tanpa spasi) hanya saat berjalan di belakang reverse proxy (Render/Railway/Vercel)
TRUST_PROXY=

# Database Turso (libSQL)
# Remote:  TURSO_DATABASE_URL=libsql://<nama-db>-<organisasi>.turso.io
#          TURSO_AUTH_TOKEN=<token dari dashboard Turso>
# Local:   biarkan kosong keduanya, otomatis memakai file data/karang-taruna.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secret untuk JWT (login admin) — ganti dengan nilai acak yang aman
# (BERBEDA dari nilai production)
JWT_SECRET=ganti-dengan-secret-acak-yang-aman

# Password admin (wajib di produksi). Dipakai hanya saat seed admin_users kosong.
# Jika tidak di-set, backend membuat password acak sekali pakai dan menampilkannya di log.
ADMIN_PASSWORD=

# (Opsional) Pepper yang ditambahkan ke password sebelum hashing (simpan hanya di environment)
ADMIN_PEPPER=

# (Opsional) Token Vercel Blob untuk upload gambar berita di produksi.
# Jika dikosongkan, gambar disimpan ke folder lokal backend/uploads/ (development).
BLOB_READ_WRITE_TOKEN=
